# 复制为 jar 同级 config/application.yml（可选）
doumi:
  update:
    # root systemd 系统服务可更新；容器/非 root 托管部署请设为 false。
    enabled: ${DOUMI_UPDATE_ENABLED:true}
    # 默认免密授权；设为 true 后，保存更新设置和安装更新需要管理密钥。
    require-token: ${DOUMI_UPDATE_REQUIRE_TOKEN:false}
    # 可选下载地址前缀，如 https://gh-proxy.com/；留空直连。页面保存的设置优先。
    proxy: ${DOUMI_UPDATE_PROXY:}
    # 可选 HTTP CONNECT 下载代理，仅转发安装包与校验文件；页面保存的设置优先。
    http-proxy: ${DOUMI_UPDATE_HTTP_PROXY:}
    # 开启密钥验证后，留空时在数据目录 updates/admin-token 自动生成，不要提交真实密钥。
    token: ${DOUMI_UPDATE_TOKEN:}
    # 可选 GitHub API Token，仅用于 GitHub API 直连；也可在更新页面加密保存。
    github-token: ${DOUMI_GITHUB_TOKEN:}

  storage:
    data-dir: ./data

  rdp:
    enabled: ${DOUMI_RDP_ENABLED:true}
    guacd-host: ${DOUMI_GUACD_HOST:127.0.0.1}
    guacd-port: ${DOUMI_GUACD_PORT:4822}
    max-sessions: 20
    idle-timeout-minutes: 30

  ssh-console:
    # 留空时自动在 data 目录生成并持久化 master.key；备份数据时请保留该文件。
    credential-master-key: ${SSH_CONSOLE_MASTER_KEY:}
    # Linux 主机优先使用 tmux 保持网页刷新后的终端现场；未安装 tmux 时自动回退。
    tmux-enabled: true

server:
  port: 80
